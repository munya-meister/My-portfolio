# Server-side configuration (local .env / Netlify environment variables)
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_PASSWORD=your-secure-admin-password

# Contact email (optional; failed email delivery falls back to database storage)
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL=your-email@example.com

# Optional frontend development override.
# Leave blank when using same-origin /api routes (recommended for Netlify).
VITE_API_BASE_URL=
